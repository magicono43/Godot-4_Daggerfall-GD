extends "res://tests/climbing.gd"

func fresh() -> void:
	Input.action_release("crouch")
	player.crouch.reset(player)
	await reset()

func toggle_crouch() -> void:
	Input.action_press("crouch")
	await frames(1)
	Input.action_release("crouch")
	await frames(1)

func run() -> void:
	for action in ["crouch", "forward", "back", "left", "right", "jump", "sprint", "reload_movement", "movement_debug", "release_mouse", "interact", "reset"]:
		if not InputMap.has_action(action):
			InputMap.add_action(action)
	arena = Node3D.new()
	root.add_child(arena)
	box(Vector3(80, 1, 80), Vector3(0, -0.5, 0))
	player = preload("res://scripts/player.gd").new()
	arena.add_child(player)
	await fresh()
	var model = player.movement
	check(absf(model.resolve().crouch_walk_speed - 100.0 / 39.5) < 0.001, "DFU crouch walk uses independent base without walking drag")
	model.set_live_stats({"speed_attribute": 80.0, "running_skill": 60.0})
	model.set_modifier("crouch_test", {"crouch": 0.5})
	check(absf(model.resolve().crouch_run_speed - 130.0 / 39.5 * 1.65 * 0.5) < 0.001, "Live Speed, Running and crouch modifiers resolve outside physical motor")
	model.set_live_stats({})
	model.remove_modifier("crouch_test")
	var feet := player.position.y
	await toggle_crouch()
	await frames(2)
	check(player.camera.position.y < player.EYE_HEIGHT and player.camera.position.y > 0.81, "Crouch camera lowers gradually")
	check(is_equal_approx(player.capsule_collision.shape.height, player.STANDING_HEIGHT), "Standing capsule protects camera during initial lowering")
	await frames(12)
	check(player.crouch.is_low(player) and absf(player.camera.position.y - 0.81) < 0.01, "Ctrl reaches DFU 0.9 m capsule and 0.81 m eye")
	check(absf(player.position.y - feet) < 0.01 and absf(player.capsule_collision.position.y - 0.45) < 0.001, "Crouching preserves foot position")
	check(player.crouch.toggled and player.crouch.is_low(player) and not Input.is_action_pressed("crouch"), "Releasing Ctrl retains crouch toggle")
	Input.action_press("crouch")
	await frames(20)
	check(not player.crouch.toggled and not player.crouch.active, "Holding Ctrl triggers only one toggle")
	Input.action_release("crouch")
	await frames(2)
	await toggle_crouch()
	await frames(15)
	Input.action_press("forward")
	await frames(12)
	check(absf(-player.velocity.z - 100.0 / 39.5) < 0.01, "Physical crouch walking uses resolved speed")
	Input.action_press("sprint")
	await frames(12)
	check(absf(-player.velocity.z - 147.5 / 39.5) < 0.01, "Crouched Shift uses DFU crouched running formula")
	release()
	await toggle_crouch()
	await frames(15)
	check(not player.crouch.active and absf(player.camera.position.y - player.EYE_HEIGHT) < 0.01, "Second Ctrl press restores standing smoothly in open space")
	var roof := box(Vector3(4, 0.3, 3), Vector3(0, 1.25, -4))
	await fresh()
	Input.action_press("forward")
	await frames(70)
	release()
	check(player.position.z > -2.6, "Standing capsule cannot walk through 1.1 m opening")
	await toggle_crouch()
	await frames(15)
	Input.action_press("forward")
	await frames(35)
	release()
	check(player.position.z < -3.0 and player.crouch.is_low(player), "Crouched capsule enters low opening")
	await toggle_crouch()
	await frames(15)
	check(player.crouch.blocked and player.crouch.is_low(player) and player.camera.position.y < 0.83, "Toggling off under roof stays crouched and reports blocked standing")
	player.step_camera_offset = 0.3
	await frames(1)
	check(player.camera.position.y <= 0.82, "Positive stair camera offset cannot clip through low roof")
	Input.action_press("jump")
	await frames(12)
	Input.action_release("jump")
	check(player.crouch.is_low(player) and player.position.y + player.capsule_collision.shape.height < 1.12, "Crouched jump beneath low ceiling stays within available clearance")
	Input.action_press("forward")
	await frames(90)
	release()
	check(not player.crouch.active and player.position.z < -6.0, "Leaving low opening completes the pending stand toggle")
	roof.queue_free()
	await frames(2)
	await fresh()
	await toggle_crouch()
	await frames(15)
	player.position = Vector3(0, 0.02, -4)
	var shoulder := box(Vector3(0.2, 0.3, 1), Vector3(0.3, 1.6, -4))
	await frames(2)
	await toggle_crouch()
	await frames(15)
	check(player.crouch.blocked, "Full capsule stand check detects off-centre shoulder obstruction")
	shoulder.queue_free()
	await frames(15)
	check(not player.crouch.active, "Removing overhead obstruction permits standing")
	await fresh()
	var too_low := box(Vector3(4, 0.3, 3), Vector3(0, 0.95, -4))
	await toggle_crouch()
	await frames(15)
	Input.action_press("forward")
	await frames(100)
	release()
	check(player.crouch.is_low(player) and player.position.z > -2.8 and absf(player.position.y) < 0.02, "Opening below crouched height still blocks capsule without floor clipping")
	too_low.queue_free()
	await frames(2)
	await fresh()
	await toggle_crouch()
	await frames(15)
	Input.action_press("jump")
	await frames(2)
	Input.action_release("jump")
	check(player.crouch.is_low(player) and player.crouch.toggled and player.velocity.y > 3.0, "Jump launches with crouched capsule and preserves toggle")
	await frames(8)
	check(player.crouch.is_low(player) and absf(player.camera.position.y - 0.81) < 0.02, "Crouch capsule and eye stay low throughout jump")
	await frames(60)
	check(player.crouch.is_low(player) and player.is_grounded(), "Landing remains crouched without another Ctrl press")
	await fresh()
	await toggle_crouch()
	Input.action_press("jump")
	await frames(2)
	Input.action_release("jump")
	await frames(12)
	check(player.crouch.toggled and player.crouch.is_low(player) and not player.is_grounded(), "Quick jump during crouch transition finishes crouching in flight")
	await fresh()
	Input.action_press("jump")
	await frames(2)
	Input.action_release("jump")
	await toggle_crouch()
	await frames(5)
	check(player.crouch.toggled and not player.crouch.is_low(player), "New midair crouch toggle is remembered without immediate capsule shrink")
	await frames(55)
	check(player.crouch.toggled and player.crouch.is_low(player) and player.is_grounded(), "Queued midair crouch toggle applies on landing without holding Ctrl")
	await fresh()
	var step := box(Vector3(3, 0.3, 3), Vector3(0, 0.15, -3))
	await toggle_crouch()
	await frames(15)
	Input.action_press("forward")
	await frames(80)
	release()
	check(player.crouch.is_low(player) and player.is_grounded() and absf(player.position.y - 0.3) < 0.03, "Short capsule retains grounded step traversal")
	step.queue_free()
	await frames(2)
	await fresh()
	var wall := box(Vector3(6, 5, 1), Vector3(0, 2.5, -2))
	await toggle_crouch()
	Input.action_press("forward")
	await frames(130)
	check(not player.climbing.active and player.crouch.is_low(player), "Crouched wall push does not start standing climbing motor")
	await toggle_crouch()
	await frames(110)
	check(player.climbing.active and not player.crouch.is_low(player), "Toggling crouch off allows standing wall attachment")
	await toggle_crouch()
	await frames(20)
	check(player.climbing.active and is_equal_approx(player.capsule_collision.shape.height, player.STANDING_HEIGHT), "Ctrl while climbing keeps standing capsule and climbing ownership")
	release()
	await toggle_crouch()
	wall.queue_free()
	arena.queue_free()
	await frames(2)
	await hall_cleanup_checks()
	print("CROUCH %d/%d" % [results.size() - failures.size(), results.size()])
	var report := FileAccess.open("res://tests/crouch_results.txt", FileAccess.WRITE)
	report.store_string("\n".join(results) + "\n")
	quit(0 if failures.is_empty() else 1)

func hall_cleanup_checks() -> void:
	var level: Node3D = load("res://main.tscn").instantiate()
	root.add_child(level)
	current_scene = level
	await frames(30)
	player = level.player
	check(not level.classic.section.definition.prototype.has("crouch_test") and get_nodes_in_group("crouch_test_structure").is_empty(), "Playable hall contains no custom crouch passage or sign")
	var point: Vector3 = level.classic.to_world([800, -512, 1280])
	var query := PhysicsRayQueryParameters3D.create(point + Vector3.UP * 2, point + Vector3.DOWN * 0.1, 1, [player.get_rid()])
	var hit := player.get_world_3d().direct_space_state.intersect_ray(query)
	check(not hit.is_empty() and absf(hit.position.y - point.y) < 0.02, "Former test passage area exposes the untouched original hall floor")
